---
import { Menu, Zap } from '@lucide/astro';
import site from '@content/site.json';
import ThemeToggle from '@components/ThemeToggle.astro';

const nav = site.nav;
---

<header class="navbar bg-base-100/80 border-base-200 sticky top-0 z-50 border-b backdrop-blur">
  <div class="navbar-start">
    <div class="dropdown">
      <button type="button" aria-label="Open main menu" class="btn btn-ghost lg:hidden">
        <Menu class="size-6" aria-hidden="true" />
      </button>
      <ul
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-50 mt-3 w-56 p-2 shadow-lg"
      >
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <a href="#hero" class="btn btn-ghost gap-2 px-2 text-lg" aria-label={`${site.name} — Home`}>
      <Zap class="text-primary size-5" aria-hidden="true" />
      <span class="font-semibold">{site.name}</span>
    </a>
  </div>

  <nav class="navbar-center hidden lg:flex" aria-label="Primary">
    <ul class="menu menu-horizontal gap-1 px-1">
      {
        nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="navbar-end gap-2">
    <ThemeToggle />
    <a href="#contact" class="btn btn-primary btn-sm hidden sm:inline-flex"> Get Started </a>
  </div>
</header>
